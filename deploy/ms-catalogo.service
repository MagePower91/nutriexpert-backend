[Unit]
Description=NutriExpert ms-catalogo
After=network.target


[Service]
User=ec2-user
WorkingDirectory=/opt/nutriexpert/ms-catalogo
# t3.micro tiene 1 GB: se limita la memoria de cada servicio para que quepan los tres.
ExecStart=/usr/bin/java -Xms64m -Xmx200m -XX:+UseSerialGC -jar /opt/nutriexpert/ms-catalogo/ms-catalogo.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
