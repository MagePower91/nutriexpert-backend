            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Prueba\",\n  \"correo\": \"ana.prueba@nutriexpert.cl\",\n  \"rol\": \"ASESOR\",\n  \"clave\": \"ClavePrueba123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201 o 409 si ya existe\", () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "if (pm.response.code === 201) { pm.test(\"No devuelve la clave\", () => { const j = pm.response.json(); pm.expect(j).to.not.have.property(\"clave\"); pm.expect(j).to.not.have.property(\"claveHash\"); }); }"
                ]
